NODE_ENV=development
PORT=3000

# Banco de dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=projeto_backend

# JWT
JWT_SECRET=troque
JWT_EXPIRES_IN=1h

# bcrypt
BCRYPT_ROUNDS=10

# Upload de imagens (pasta relativa à raiz do projeto)
UPLOAD_DIR=uploads
# URL pública usada para montar o link das imagens (opcional; por padrão usa o host da requisição)
PUBLIC_URL=
